# ============================================================
# OmniAgent — Environment configuration
# Copy to .env and fill in your values.
# ============================================================

# ---------- Server ----------
OMNI_HOST=0.0.0.0
OMNI_PORT=8787
OMNI_BASE_URL=http://localhost:8787
# Path to Next.js static export. If set, OmniAgent serves the SPA from this dir.
# Leave empty to run API-only (e.g. when web is on a separate Vercel).
OMNI_WEB_DIR=
# Secret used to sign session cookies (HMAC-SHA256). Generate: openssl rand -hex 32
OMNI_COOKIE_SECRET=
# API request timeout for the agent subprocess (seconds)
OMNI_AGENT_TIMEOUT=600

# ---------- Database ----------
# SQLite path (relative to working dir or absolute)
OMNI_DB_PATH=./omniagent.db

# ---------- Approved workspace ----------
# Base directory that all CLI agents are allowed to read/write.
# Subdirectories created here become "projects".
OMNI_WORKSPACE=/srv/omniagent/workspace

# ---------- Per-user tokens ----------
# Comma-separated list of "<token>:<label>" pairs.
# Each token is what an end user types into the web login form
# or sends to the Telegram bot as /start <token>.
# Generate tokens with: openssl rand -hex 24
OMNI_USER_TOKENS=dev1-demo-aaaaaaaaaaaaaaaaaaaaaaaa:Developer 1,dev2-demo-bbbbbbbbbbbbbbbbbbbbbbbb:Developer 2

# ---------- Telegram bot ----------
# Get from https://t.me/BotFather
OMNI_TELEGRAM_TOKEN=
# Optional: webhook URL (https://your.domain/tg/<secret>). If empty, uses long polling.
OMNI_TELEGRAM_WEBHOOK_URL=
OMNI_TELEGRAM_WEBHOOK_SECRET=

# ---------- Cloudflare Turnstile ----------
# Get from https://dash.cloudflare.com/?to=/:account/turnstile
OMNI_TURNSTILE_SITE_KEY=
OMNI_TURNSTILE_SECRET_KEY=
# Set to false to disable Turnstile verification (dev only)
OMNI_TURNSTILE_ENABLED=true

# ---------- Security: progressive ban ----------
OMNI_BAN_MAX_FAILS=5
OMNI_BAN_WINDOW_SECONDS=300
OMNI_BAN_DURATION_SECONDS=900

# ---------- Rate limit (token bucket, per user) ----------
OMNI_RATE_LIMIT_RPS=2
OMNI_RATE_LIMIT_BURST=10

# ---------- Adapters ----------
# Optional explicit paths; otherwise resolved via PATH lookups
OMNI_CLAUDE_BIN=claude
OMNI_CODEX_BIN=codex
OMNI_GEMINI_BIN=gemini
OMNI_ANTIGRAVITY_BIN=antigravity
OMNI_ZCODE_BIN=zcode
# Optional extra env passed to every adapter (KEY=VAL;KEY=VAL)
OMNI_ADAPTER_ENV=ANTHROPIC_API_KEY=,OPENAI_API_KEY=,GEMINI_API_KEY=

# ---------- Logging ----------
# text | json
OMNI_LOG_FORMAT=text
# debug | info | warn | error
OMNI_LOG_LEVEL=info

# ---------- Admin ----------
# Bearer token for /api/admin/* endpoints. Generate: openssl rand -hex 32
OMNI_ADMIN_TOKEN=
